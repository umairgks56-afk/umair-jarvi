JARVIS_NAME=JARVIS
USER_NAME=Umair

# AI: DeepSeek is the primary cloud brain when the API key is present.
# If the key is missing or the API is unavailable, JARVIS falls back to local Ollama.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local fallback brain
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
MEMORY_DB=./data/jarvis.db

# PC-only default. For phone access on the same Wi-Fi/LAN, change to 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8765

# Set a long random value before enabling LAN access.
JARVIS_API_KEY=

# Natural local voice settings (pyttsx3 / Windows SAPI).
JARVIS_TTS_VOICE=
JARVIS_TTS_PREFERRED_VOICES=Microsoft David,Microsoft Mark,Microsoft Guy,Microsoft Zira
JARVIS_TTS_RATE=165
JARVIS_TTS_VOLUME=0.95

# Folders JARVIS is allowed to search/read. Use ; between Windows paths.
# Example: C:\\Users\\Umair\\Documents;C:\\Users\\Umair\\Downloads;C:\\Users\\Umair\\Desktop
JARVIS_DATA_ROOTS=
