JARVIS_NAME=JARVIS
USER_NAME=Umair
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
MEMORY_DB=./data/jarvis.db

# PC-only default. For phone access on the same Wi-Fi/LAN, change to 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8765

# Set a long random value before enabling LAN access.
JARVIS_API_KEY=

# Natural local voice settings (pyttsx3 / Windows SAPI).
# Leave JARVIS_TTS_VOICE empty to auto-pick a preferred installed voice.
JARVIS_TTS_VOICE=
JARVIS_TTS_PREFERRED_VOICES=Microsoft David,Microsoft Mark,Microsoft Guy,Microsoft Zira
JARVIS_TTS_RATE=165
JARVIS_TTS_VOLUME=0.95
